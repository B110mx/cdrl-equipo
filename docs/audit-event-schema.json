{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDRL access audit event",
  "type": "object",
  "required": ["actor", "action", "resource", "result", "occurred_at"],
  "properties": {
    "actor": {
      "type": "string",
      "pattern": "^(role|service):[a-z][a-z0-9_-]{0,62}$"
    },
    "action": {
      "enum": ["read", "write", "administer", "query_audit", "append_audit"]
    },
    "resource": {
      "type": "string",
      "pattern": "^(events|audit):[A-Za-z0-9_.-]{1,128}$"
    },
    "result": {
      "enum": ["succeeded", "failed", "denied"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at_audit_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": ["succeeded", "failed", "denied"]
    },
    "changed_fields": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
